def perm (r : Row) (x : V) := (images.getD r.val []).getD x.val 0
def inv (r : Row) (x : V) := (inverseImages.getD r.val []).getD x.val 0
def start (r : Row) := starts.getD r.val (0,0)

theorem left_inverse : ∀ r x, inv r (perm r x)=x := by decide +kernel
theorem right_inverse : ∀ r x, perm r (inv r x)=x := by decide +kernel
def equiv (r : Row) : V ≃ V := ⟨perm r,inv r,left_inverse r,right_inverse r⟩
set_option maxHeartbeats 2000000 in
theorem adj_eq : ∀ r a b, adj (perm r a) (perm r b)=adj a b := by decide +kernel
theorem starts_at : ∀ r, samePair (perm r 7) (perm r 12) (start r).1 (start r).2 := by decide +kernel
theorem all_pairs : ∀ a b : V, a≠b → (a.val<7 ↔ b.val<7) → ∃ r, samePair (start r).1 (start r).2 a b := by decide +kernel

